# 이 파일을 workspace/ 안에 이름을 바꿔 복사해 설정 파일을 만든다(사람이 만든다. 커밋하지 않는다).
# 저장소 맨 위의 설정 파일도 읽는다(workspace 쪽이 우선). 키 값은 화면·기록·로그에 넣지 않는다.

# 팀 Claude API 키
ANTHROPIC_API_KEY=

# 폰 폴더 경로(workspace/ 기준 상대 경로도 된다)
AIDIC_PHONE_DIR=../Mobile Storage

# 모든 호출의 모델
AIDIC_MODEL=claude-opus-5-5

# 서버 포트(127.0.0.1에만 묶는다)
AIDIC_PORT=8000

# cache면 웹 캐시로만 답한다. live면 실제로 웹을 검색하고, 막히면 웹 캐시로 답한다
AIDIC_WEB_SEARCH=cache

# 아래는 비워 두면 기본값을 쓴다.
# 커밋하는 데이터 폴더(descriptions.jsonl, links.jsonl, web_cache.json, blurred/). 기본 data
# AIDIC_DATA_DIR=data
# 커밋하지 않는 생성물 폴더(catalog, index, photos, runs, replay.html). 기본 var
# AIDIC_VAR_DIR=var
# 통과한 실행 기록 폴더. 기본 eval/passed
# AIDIC_PASSED_DIR=eval/passed
# 정답 키. 기본 eval/answer_key.json
# AIDIC_ANSWER_KEY=eval/answer_key.json
# 한 프로세스가 Claude에 쓸 수 있는 누적 비용(달러). 넘으면 멈춘다. 기본 100
# AIDIC_COST_CAP_USD=100
# 찍은 시각에 시간대가 없을 때 붙일 시간대. 기본 +09:00
# AIDIC_DEFAULT_TZ=+09:00
# Hindsight 기억 저장소. 주소와 은행을 주면 에이전트 루프에 기억 꺼내기 도구(recall_memory)와 기억 되짚기 도구(reflect_memory)가 붙고, eval.hindsight 명령도 이 은행을 쓴다
# AIDIC_HINDSIGHT_URL=http://localhost:8888
# AIDIC_HINDSIGHT_BANK=
